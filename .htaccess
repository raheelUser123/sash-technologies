Options -Indexes
DirectoryIndex index.php
ErrorDocument 404 /404.php

<IfModule mod_mime.c>
    AddType application/xml .xml
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header set Cache-Control "max-age=3600, must-revalidate"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<Files "sitemap.xml">
    <IfModule mod_headers.c>
        Header set Content-Type "application/xml; charset=UTF-8"
        Header set Cache-Control "max-age=3600, must-revalidate"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Header always set X-Frame-Options "SAMEORIGIN"
    </IfModule>
</Files>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
</IfModule>

RewriteEngine On

# 1. Redirect external GET requests with .php to extensionless (using THE_REQUEST to avoid loops)
# This prevents POST requests (like contact form submissions to process-contact.php) from losing POST data in a 301 redirect.
RewriteCond %{REQUEST_METHOD} GET
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^\s]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Redirect trailing slash to non-trailing slash (excluding actual directories)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L]

# 3. Internal rewrite for blog post URLs: /blog/article-slug -> blog.php?slug=article-slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog.php?slug=$1 [QSA,L]

# 4. Internal rewrite to add .php extension for existing PHP files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([^/]+)$ $1.php [NC,L]